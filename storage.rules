rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Speaker identity is name+PIN derived rather than tied to Firebase's own
    // auth.uid (see src/firebase.js for why), so these rules cannot restrict
    // access to "this specific speaker". They do, however, prevent the most
    // damaging abuses: listing every recording, overwriting or deleting an
    // existing one, and uploading non-audio or oversized files.
    match /recordings/{speakerId}/{fileName} {
      // Single-object reads only (needed for getDownloadURL); no listing.
      allow get: if request.auth != null;
      // New files only: no update, no delete.
      allow create: if request.auth != null
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
    }
  }
}
