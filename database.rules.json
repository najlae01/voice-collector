{
  "rules": {
    "speakers": {
      "$speakerId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 100"
      }
    },
    "recordings": {
      "$speakerId": {
        ".read": "auth != null",
        "$utteranceId": {
          "$seq": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['fileName', 'utteranceId', 'spokenText', 'speakerId', 'audioPath']) && newData.child('speakerId').val() === $speakerId && newData.child('utteranceId').val() === $utteranceId && newData.child('spokenText').isString() && newData.child('spokenText').val().length <= 1000"
          }
        }
      }
    }
  }
}
